APP_NAME="DAR-LTCMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dar_iland
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Local development keeps outgoing mail in the application log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@dar-ltcms.local"
MAIL_FROM_NAME="${APP_NAME}"

# For production password-recovery email, configure a transactional-email
# provider through SMTP. No mail server needs to be installed on the VPS.
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="no-reply@darltcms.me"
# MAIL_FROM_NAME="DAR-LTCMS"

# Production HTTPS deployment baseline for darltcms.me:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://darltcms.me
# LOG_LEVEL=warning
# FILESYSTEM_DISK=local
# SESSION_DRIVER=database
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax
# MAIL_MAILER=smtp
#
# Host-header protection defaults to the exact host in APP_URL. Only configure
# TRUSTED_HOSTS when an additional exact hostname (such as www) is intentional.
# Values are comma-separated regular expressions.
# TRUSTED_HOSTS=^darltcms\.me$,^www\.darltcms\.me$
#
# Configure TRUSTED_PROXIES only when CloudPanel/Nginx or another reverse proxy
# forwards the original HTTPS scheme to PHP. Prefer explicit proxy IPs/CIDRs.
# Do not use * unless the upstream proxy strips client-supplied forwarded headers.
# TRUSTED_PROXIES=127.0.0.1
#
# After configuring production, this command must pass before deployment:
# php artisan dar:check-production-readiness