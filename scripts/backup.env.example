# DAR-LTCMS production backup configuration template
#
# DO NOT put real credentials in this repository.
# Copy this file on the production server to:
#   ~/.config/dar-ltcms/backup.env
# then run:
#   chmod 600 ~/.config/dar-ltcms/backup.env
#
# Recommended destination: a private Backblaze B2 bucket accessed through
# its S3-compatible HTTPS endpoint.

# Restic repository format for Backblaze B2 S3-compatible API:
# s3:https://s3.<region>.backblazeb2.com/<private-bucket-name>/dar-ltcms
RESTIC_REPOSITORY="s3:https://s3.<region>.backblazeb2.com/<private-bucket-name>/dar-ltcms"

# Store the encryption password in a separate 600-permission file.
RESTIC_PASSWORD_FILE="$HOME/.config/dar-ltcms/restic-password"

# Backblaze B2 S3-compatible application key ID and application key.
AWS_ACCESS_KEY_ID="<application-key-id>"
AWS_SECRET_ACCESS_KEY="<application-key>"
AWS_DEFAULT_REGION="<region>"

# Optional retention overrides. Defaults used by the script are shown here.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3

# Percentage of repository data sampled by restic check after each backup.
# Set to 0 only if you intentionally want to skip data sampling.
BACKUP_CHECK_PERCENT=5

# Local staging safety headroom in MiB beyond the current PostgreSQL database size.
BACKUP_MIN_HEADROOM_MB=256

# Optional logical label used by restic snapshots.
BACKUP_HOST="darltcms-production"
BACKUP_TAG="dar-ltcms-production"
